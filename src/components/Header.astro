---
import { NAV, NAV_ZH } from '../lib/site';
import { url } from '../lib/url';
interface Props { locale?: 'en' | 'zh' }
const { locale = 'en' } = Astro.props;
const nav = locale === 'zh' ? NAV_ZH : NAV;
const home = locale === 'zh' ? '/zh/' : '/';
const switchHref = locale === 'zh' ? '/' : '/zh/';
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href={url(home)}>
      <!-- Compact (no-tagline) logo: brand rule for widths under ~200px. -->
      <img
        src={url('/brand/raise_hub_no_tagline.png')}
        alt="RAISE Hub — home"
        width="176"
        height="45"
      />
    </a>
    <nav class="site-nav" aria-label={locale === 'zh' ? '主导航' : 'Main'}>
      <ul>
        {nav.map((item) => (
          <li>
            <a href={url(item.href)}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="language-switch" href={url(switchHref)} hreflang={locale === 'zh' ? 'en' : 'zh-CN'}>
      {locale === 'zh' ? 'EN' : '中文'}
    </a>
  </div>
</header>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    padding-block: var(--space-s);
  }
  .site-header__logo {
    display: inline-block;
    flex-shrink: 0;
  }
  .site-header__logo img {
    width: 176px;
    height: auto;
  }
  /* Nav starts right after the logo and fills the rest of the header, items evenly spaced. */
  .site-nav {
    flex: 1 1 28rem;
    max-width: 49rem;
    margin-inline-start: var(--space-m);
  }
  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.15rem 0.35rem;
  }
  .site-nav li + li {
    margin-top: 0;
  }
  .site-nav a {
    display: inline-block;
    padding: 0.45rem 0.65rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }
  .site-nav a:hover {
    color: var(--maroon);
    border-bottom-color: var(--border);
  }
  .language-switch {
    flex-shrink: 0;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--maroon);
    border-radius: var(--radius-s);
    font-weight: 700;
    text-decoration: none;
  }
  .language-switch:hover {
    background: var(--maroon);
    color: var(--white);
  }
  @media (max-width: 40rem) {
    .site-nav {
      width: 100%;
      flex-basis: 100%;
      margin-inline-start: 0;
    }
    .site-nav ul {
      margin-inline: -0.65rem;
      justify-content: flex-start;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 0.2rem;
    }
    .site-nav a {
      white-space: nowrap;
    }
  }
</style>
