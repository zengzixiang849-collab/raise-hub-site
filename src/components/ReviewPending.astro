---
// Shows an open question for Annus. Visible in draft mode. In a public build
// (PUBLIC_DRAFT=false) an open item BLOCKS the build — the decision must be
// made and this component removed first, so unresolved content can never be
// published silently (Codex review, 29 Oct).
import { IS_DRAFT } from '../lib/site';

interface Props {
  /** Short description of what needs Annus's decision. */
  note?: string;
  /** Optional checklist reference, e.g. "A5" (planning/review-checklist.md). */
  item?: string;
}
const { note, item } = Astro.props;
if (!IS_DRAFT) {
  throw new Error(
    `Public build blocked (PUBLIC_DRAFT=false): open review item ${item ?? ''} on ${Astro.url.pathname} — "${note ?? ''}". ` +
      'Record Annus\'s decision in planning/review-checklist.md, apply it, and remove this ReviewPending.',
  );
}
---
{IS_DRAFT && (
  <aside class="review-pending" aria-label="Review pending">
    <span class="review-pending__label">Review pending{item ? ` · ${item}` : ''}:</span>
    {note && <span> {note}</span>}
    <slot />
  </aside>
)}

<style>
  .review-pending {
    border: 2px dashed #b8b2a7;
    border-radius: var(--radius);
    background: #fbfaf8;
    color: var(--gray);
    font-size: var(--step--1);
    line-height: 1.5;
    padding: 0.55rem 0.8rem;
    margin: var(--space-s) 0;
    max-width: var(--text-max);
  }
  .review-pending__label {
    font-weight: 700;
    color: var(--ink);
  }
</style>
