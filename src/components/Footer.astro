---
import { NAV, NAV_ZH, SITE } from '../lib/site';
import { url } from '../lib/url';
import ReviewPending from './ReviewPending.astro';
interface Props { locale?: 'en' | 'zh' }
const { locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const nav = zh ? NAV_ZH : NAV;
---
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <!-- Reversed logo: brand rule for dark backgrounds (kept ≥ 200px wide). -->
      <img
        src={url('/brand/raise_hub_teaching_learning_reversed.png')}
        alt="RAISE Hub — Responsible AI for Teaching and Learning"
        width="240"
        height="81"
        loading="lazy"
      />
      <p class="site-footer__name">
        <strong>{SITE.name}</strong> · {SITE.fullName} · {SITE.college}
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <h2 class="site-footer__heading">{zh ? '浏览' : 'Explore'}</h2>
      <ul>
        {nav.map((item) => (
          <li><a href={url(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__contact">
      <h2 class="site-footer__heading">{zh ? '联系' : 'Contact'}</h2>
      <p><a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
      <ReviewPending item="A5" note="Confirm this email may appear publicly, and whether to add office hours or a location." />
    </div>
  </div>

  <div class="container site-footer__legal">
    <p>
      {zh
        ? '人工智能可能出错。使用任何信息前请进行核实。工作坊示例使用虚构课程材料。请遵循 ASU 关于生成式人工智能、无障碍和学生数据的政策。本网站不构成对任何人工智能厂商或产品的认可。'
        : 'AI can make mistakes. Verify all information before you use it. Workshop examples use fictional course materials. Follow ASU policy on generative AI, accessibility and student data. No endorsement of any AI vendor or product is implied.'}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    color: var(--light-gray);
    border-top: 6px solid var(--gold); /* thick gold block on dark: allowed */
    margin-top: var(--space-2xl);
    font-size: var(--step--1);
  }
  .site-footer__grid {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: 1fr;
    padding-block: var(--space-xl) var(--space-l);
  }
  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 2fr 1fr 1.4fr;
    }
  }
  .site-footer__brand img {
    width: 240px;
    height: auto;
    margin-bottom: var(--space-s);
  }
  .site-footer__name {
    color: var(--light-gray);
  }
  .site-footer__name strong {
    color: var(--white);
  }
  .site-footer__heading {
    font-size: var(--step-0);
    color: var(--white);
    margin-bottom: var(--space-xs);
  }
  .site-footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .site-footer a {
    color: var(--white);
  }
  .site-footer a:hover {
    color: var(--gold);
  }
  .site-footer :focus-visible {
    outline-color: var(--gold);
  }
  .site-footer__legal {
    border-top: 1px solid #3a3a3a;
    padding-block: var(--space-m) var(--space-l);
  }
  .site-footer__legal p {
    max-width: 60rem;
    margin: 0;
    color: var(--light-gray);
  }
</style>
