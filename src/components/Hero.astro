---
import { url } from '../lib/url';
import { PHOTO_WIDTHS, PHOTO_RATIO, assertPhotoFiles } from '../lib/photos';

interface Props { locale?: 'en' | 'zh' }
const { locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const heroImage = 'hero-workshop';
assertPhotoFiles(heroImage, 'src/components/Hero.astro');
const heroBase = `/photos/${heroImage}`;
const heroSrcset = PHOTO_WIDTHS.map((width) => `${url(`${heroBase}-${width}.webp`)} ${width}w`).join(', ');
---
<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero__grid">
    <div class="hero__text">
      <h1 id="hero-heading" class="hero__title">
        <img
          src={url('/brand/raise_hub_teaching_learning.png')}
          alt={zh ? 'RAISE Hub——负责任的人工智能教学与学习' : 'RAISE Hub — Responsible AI for Teaching and Learning'}
          width="440"
          height="149"
          fetchpriority="high"
        />
      </h1>
      <p class="hero__lede">
        {zh
          ? 'RAISE Hub 位于海南大学亚利桑那州立大学联合国际旅游学院（HAIC），帮助教师、学生和助教审慎地使用人工智能，回应真实的教学与学习需求。'
          : 'Based at the HNU–ASU Joint International College (HAIC), RAISE Hub helps faculty, students and teaching assistants use AI thoughtfully to address real teaching and learning needs. We develop useful, reusable tools — and the human judgment needed to use them responsibly.'}
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href="#workshops">{zh ? '了解工作坊' : 'Explore workshops'}</a>
        <a class="hero__text-link" href="#approach">{zh ? '了解工作方法' : 'How we work'}</a>
      </div>
    </div>

    <figure class="hero__media">
      <picture>
        <img
          src={url(`${heroBase}-1200.webp`)}
          srcset={heroSrcset}
          sizes="(min-width: 58rem) 46vw, 100vw"
          width="1200"
          height={Math.round(1200 * PHOTO_RATIO)}
          alt={zh ? '学生在 RAISE Hub 工作坊中使用笔记本电脑完成课堂活动' : 'Students use laptops for a classroom activity during a RAISE Hub workshop'}
          fetchpriority="high"
        />
      </picture>
      <figcaption>
        <span>{zh ? '教学实践现场' : 'Teaching in practice'}</span>
        <span>RAISE Hub workshop</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 4vw, 3.75rem);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .hero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }
  @media (min-width: 58rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.04fr) minmax(24rem, 0.96fr);
    }
  }
  .hero__title { margin: 0 0 var(--space-l); }
  .hero__title img {
    width: min(100%, 500px);
    margin-left: -4.5%;
  }
  .hero__lede {
    font-size: var(--step-1);
    line-height: 1.65;
    margin-bottom: var(--space-l);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
  }
  .hero__text-link {
    font-weight: 700;
    text-underline-offset: 0.3em;
  }
  .hero__media {
    position: relative;
    min-height: 20rem;
    margin: 0;
    background: var(--maroon);
    border-radius: var(--radius-l);
    overflow: hidden;
    box-shadow: 0 24px 50px -38px rgba(38, 38, 38, 0.75);
    border-bottom: 8px solid var(--gold);
  }
  .hero__media picture,
  .hero__media img {
    width: 100%;
    height: 100%;
    min-height: 20rem;
    display: block;
  }
  .hero__media img {
    object-fit: cover;
    object-position: center;
  }
  .hero__media figcaption {
    position: absolute;
    inset: auto var(--space-m) var(--space-m) var(--space-m);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-m);
    padding: 0.65rem 0.85rem;
    background: rgba(110, 21, 50, 0.94);
    color: var(--white);
    border-radius: var(--radius);
    font-weight: 700;
    font-size: var(--step--1);
  }
  @media (max-width: 36rem) {
    .hero__media,
    .hero__media picture,
    .hero__media img { min-height: 17rem; }
  }
</style>
