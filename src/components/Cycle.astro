---
interface Props { locale?: 'en' | 'zh' }
const { locale = 'en' } = Astro.props;
const STEPS = locale === 'zh'
  ? [
      { verb: '识别', lead: '识别真实需求', rest: '从 HAIC 的教学或学习需求出发。' },
      { verb: '构建', lead: '构建或调整', rest: '一个小型工具或工作流程。' },
      { verb: '评估', lead: '评估', rest: '依据获准来源和五个维度测试输出。' },
      { verb: '反思', lead: '反思证据', rest: '包括工具在哪里失败。' },
      { verb: '改进', lead: '改进并重新测试', rest: '再决定是否、如何以及由谁使用。' },
    ]
  : [
      { verb: 'Define', lead: 'Identify a real need', rest: 'in teaching or learning at HAIC.' },
      { verb: 'Build', lead: 'Build or adapt', rest: 'a small tool or workflow.' },
      { verb: 'Test', lead: 'Evaluate', rest: 'it: test its outputs against approved sources and our five dimensions.' },
      { verb: 'Reflect', lead: 'Reflect', rest: 'on what the evidence shows, including where it failed.' },
      { verb: 'Improve', lead: 'Improve', rest: 'it, retest, and decide whether, how and by whom it should be used.' },
    ];
---
<div class="practice-track">
  <ol>
    {STEPS.map((step, i) => (
      <li>
        <span class="practice-track__number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <span class="practice-track__verb">{step.verb}</span>
        <p><strong>{step.lead}</strong> {step.rest}</p>
      </li>
    ))}
  </ol>
  <p class="practice-track__return">{locale === 'zh' ? '证据把我们带回新的需求。' : 'and back to step 1'}</p>
</div>

<style>
  .practice-track {
    position: relative;
    background: var(--dark);
    color: var(--white);
    border-radius: var(--radius-l);
    padding: clamp(1.25rem, 3vw, 2.25rem);
    overflow: hidden;
  }
  .practice-track::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 10px;
    background: var(--gold);
  }
  .practice-track ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .practice-track li {
    position: relative;
    margin: 0;
    padding: var(--space-m) 0 var(--space-m) 4.4rem;
    border-bottom: 1px solid #474747;
  }
  .practice-track li:last-child { border-bottom: 0; }
  .practice-track__number {
    position: absolute;
    left: 0;
    top: 1.15rem;
    color: var(--gold);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1;
  }
  .practice-track__verb {
    display: block;
    color: var(--light-gray);
    font-size: var(--step--1);
    font-weight: 700;
    margin-bottom: var(--space-2xs);
  }
  .practice-track p { margin: 0; max-width: 35rem; }
  .practice-track strong { color: var(--white); }
  .practice-track__return {
    margin: var(--space-s) 0 0 4.4rem !important;
    color: var(--gold);
    font-weight: 700;
  }
  @media (min-width: 64rem) {
    .practice-track ol { grid-template-columns: repeat(5, 1fr); }
    .practice-track li {
      padding: 4.5rem var(--space-m) var(--space-m);
      border-bottom: 0;
      border-right: 1px solid #474747;
      min-height: 17rem;
    }
    .practice-track li:last-child { border-right: 0; }
    .practice-track__number { left: var(--space-m); top: var(--space-m); }
    .practice-track__return { margin-left: var(--space-m) !important; }
  }
</style>
