---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Cycle from '../../components/Cycle.astro';
import ReviewPending from '../../components/ReviewPending.astro';
import WorkshopFeatureRow from '../../components/WorkshopFeatureRow.astro';
import PosterCarousel from '../../components/PosterCarousel.astro';
import { SITE } from '../../lib/site';
import { url } from '../../lib/url';

const workshops = (await getCollection('workshops')).filter((w) => w.data.status === 'delivered').sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const withPoster = workshops.filter((workshop) => workshop.data.poster);
const dimensions = [
  ['准确性', '是否测试过输出中的错误？工具在哪里出错？'],
  ['偏见与公平', '它对哪些人有效，又可能对哪些人失效或造成不利影响？'],
  ['局限与不确定性', '这个工具不能做什么？什么时候不应使用？'],
  ['权力与公共价值', '谁会受益，谁承担成本？如果由社区或公共机构使用，会产生什么治理影响？'],
  ['负责任的使用决定', '综合以上问题，应不应该使用、由谁使用、在什么条件下使用，还是不予部署？'],
];
const workshopNames: Record<string, string> = {
  'canvas-page-students-read': '用 AI 构建学生真正会阅读的 Canvas 页面',
  'pick-the-right-job-for-ai': '为 AI 选择合适的任务',
  'tsa-series': '助教工作坊系列',
  'ai-learning-assistant': '负责任地构建和测试自己的 AI 学习助手',
  'using-ai-responsibly-freshmen': '负责任地使用 AI：知道何时使用以及如何检查',
  'ai-course-assistant': '负责任地构建和测试 AI 课程助手',
};
const workshopSummaries: Record<string, string> = {
  'canvas-page-students-read': '把大段文字转化为清晰、无障碍的 Canvas 页面。AI 起草 HTML，教师核实每项事实后再发布。',
  'pick-the-right-job-for-ai': '把作业拆分成具体任务，再判断每一部分应由谁完成以及为什么。',
  'tsa-series': '从选择任务，到构建范围明确的课程助手，再到测试工具并把证据交还教师做决定。',
  'ai-learning-assistant': '使用自己的学习材料构建学习指南助手，评估它的表现，再根据发现进行更新。',
  'using-ai-responsibly-freshmen': '帮助新生形成两个习惯：决定哪些部分自己完成、哪些可以借助 AI，并检查 AI 给出的内容。',
  'ai-course-assistant': '在 CreateAI 中构建课程助手，测试预期回答和指令执行情况，并在分享前完成检查。',
};
const projectNames: Record<string, string> = {
  'syllabot': 'Syllabot：课程大纲问答助手',
  'study-guide-assistant': '学习指南助手',
  'course-guide-draft-feedback': '课程指南与草稿反馈助手',
  'canvas-page-workflow': 'Canvas 页面工作流：起草、检查、发布',
};
---
<BaseLayout
  locale="zh"
  title="中文首页"
  description="RAISE Hub 帮助 HAIC 的教师、学生和助教负责任地使用人工智能解决真实的教学与学习需求。"
>
  <Hero locale="zh" />

  <section class="section" id="about" aria-labelledby="zh-about-heading">
    <div class="container split">
      <aside class="facts">
        <h2>RAISE 概览</h2>
        <dl>
          <div><dt>所在地</dt><dd>海南大学亚利桑那州立大学联合国际旅游学院（HAIC）</dd></div>
          <div><dt>服务对象</dt><dd>教师、学生与助教</dd></div>
          <div><dt>关注重点</dt><dd>真实的教学与学习需求</dd></div>
          <div><dt>工作方式</dt><dd>构建、评估、反思与改进</dd></div>
        </dl>
      </aside>
      <div>
        <span class="section-number">01</span>
        <h2 id="zh-about-heading">RAISE Hub 是什么</h2>
        <p class="lede"><strong>RAISE</strong> 是 <strong>Responsible AI Support in Education</strong> 的缩写。我们的标语 “Responsible AI for Teaching and Learning” 表明，RAISE Hub 同时服务教师与学生。</p>
        <p>RAISE Hub 帮助教师、学生和助教审慎地使用人工智能，回应真实的教学与学习需求。我们的目标既包括开发实用、可复用的工具，也包括培养负责任地使用这些工具所需的人类判断。</p>
        <a class="button button--secondary" href={url('/about/')}>阅读英文详细介绍</a>
      </div>
    </div>
  </section>

  <section class="section need" aria-labelledby="zh-need-heading">
    <div class="container split">
      <div><span class="section-number">02</span><h2 id="zh-need-heading">AI 表达流畅，<br />并不代表它是正确的。</h2></div>
      <div>
        <p class="lede">AI 工具可以在几秒内起草、总结和回答问题，也可能编造截止日期、遗漏关键信息，或者附和错误前提，并且听起来同样自信。</p>
        <p>因此，我们从值得解决的真实需求出发，判断 AI 是否适合使用，并考虑哪些人会受益或受到影响。随着工具和需求变化，我们会再次检查输出及其适用性。</p>
      </div>
    </div>
  </section>

  <section class="section" id="approach" aria-labelledby="zh-approach-heading">
    <div class="container">
      <div class="section-heading"><span class="section-number">03</span><h2 id="zh-approach-heading">在实践中学习</h2><p>我们围绕真实问题开展工作：</p></div>
      <Cycle locale="zh" />
      <p class="callout">精美的输出或较高的平台评分，本身不足以证明一个工具工作良好。</p>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="zh-audience-heading">
    <div class="container">
      <div class="section-heading"><span class="section-number">04</span><h2 id="zh-audience-heading">我们与谁合作</h2></div>
      <div class="audience-list">
        <article><span>01</span><h3>教师</h3><p>构建和测试课程助手，使用 AI 起草并通过人工检查准备更清晰的教学材料。学术判断和发布决定始终由教师保留。</p></article>
        <article><span>02</span><h3>学生</h3><p>判断作业中哪些部分应由自己完成、哪些地方可以借助 AI，并学习检查 AI 输出，对最终结果负责。</p></article>
        <article><span>03</span><h3>助教</h3><p>协助教师开发、测试和维护课程支持工具，并把测试证据交还教师做决定。</p></article>
      </div>
    </div>
  </section>

  <section class="section dimensions" aria-labelledby="zh-dimensions-heading">
    <div class="container">
      <div class="section-heading light"><span class="section-number">05</span><h2 id="zh-dimensions-heading">我们对每个工具提出的五个问题</h2></div>
      <ol>{dimensions.map(([name, question], i) => <li><span>{i + 1}</span><p><strong>{name}</strong>{question}</p></li>)}</ol>
    </div>
  </section>

  <section class="section" id="workshops" aria-labelledby="zh-workshops-heading">
    <div class="container zh-section-shell">
      <div class="section-heading"><span class="section-number">06</span><h2 id="zh-workshops-heading">代表性工作坊</h2><p>工作坊介绍 RAISE 的实践习惯，并为项目工作和后续支持提供入口。</p></div>
      <div class="zh-section-main">
        {withPoster.length > 1 && <div class="workshop-carousel"><PosterCarousel workshops={withPoster} /></div>}
        <div class="workshop-features">
          {workshops.map((workshop) => (
            <WorkshopFeatureRow
              workshop={workshop}
              title={workshopNames[workshop.id] ?? workshop.data.title}
              summary={workshopSummaries[workshop.id] ?? workshop.data.summary}
              linkLabel="查看工作坊英文详情"
            />
          ))}
        </div>
        <p class="action"><a class="button button--secondary" href={url('/workshops/')}>查看全部英文工作坊资料</a></p>
      </div>
    </div>
  </section>

  <section class="section projects" id="projects" aria-labelledby="zh-projects-heading">
    <div class="container split">
      <div><span class="section-number">07</span><h2 id="zh-projects-heading">演示项目</h2><p>每个项目都遵循“构建、评估、改进”的过程。项目只有与经过审查的评估一起呈现时才算完整。</p></div>
      <div class="project-list">{projects.map((project) => <a href={url(`/projects/${project.id}/`)}><strong>{projectNames[project.id] ?? project.data.title}</strong><span>{project.data.title}</span><small>工作坊演示；尚未部署</small></a>)}</div>
    </div>
  </section>

  <section class="section" id="resources" aria-labelledby="zh-resources-heading">
    <div class="container">
      <div class="section-heading"><span class="section-number">08</span><h2 id="zh-resources-heading">实用资源</h2><p>来自 RAISE Hub 工作坊的实践指南，帮助使用者负责任地使用和检查 AI。</p></div>
      <div class="feature-list resources">
        <a href={url('/resources/#decide')}><span>01</span><strong>决定哪些任务可以交给 AI</strong></a>
        <a href={url('/resources/#check')}><span>02</span><strong>分四步检查 AI 回答</strong></a>
        <a href={url('/resources/#choose-a-task')}><span>03</span><strong>选择值得构建的任务</strong></a>
        <a href={url('/resources/#before-sharing')}><span>04</span><strong>分享工具前的五项检查</strong></a>
      </div>
    </div>
  </section>

  <section class="section contact" id="contact" aria-labelledby="zh-contact-heading">
    <div class="container split">
      <div class="raise-mark" aria-hidden="true">R<span>AI</span>SE</div>
      <div><span class="section-number">09</span><h2 id="zh-contact-heading">负责人及联系方式</h2><p>RAISE Hub 由 Annus Azhar 博士创立。他是亚利桑那州立大学公共事务学院助理教学教授。</p><p class="lede">如果您对工作坊、项目想法或课程支持感兴趣，请联系 <a href={`mailto:${SITE.contactEmail}`}><strong>{SITE.contactEmail}</strong></a>。</p><ReviewPending item="A5" note="Confirm the founder line, title wording and public contact details." /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .split { display: grid; gap: var(--space-xl); align-items: start; }
  @media (min-width: 58rem) { .split { grid-template-columns: minmax(15rem, 0.75fr) minmax(0, 1.55fr); } }
  .facts { padding: var(--space-l); background: var(--surface-alt); border-top: 8px solid var(--maroon); }
  .facts h2 { color: var(--ink); font-size: var(--step-1); }
  .facts dl { margin: var(--space-m) 0 0; }
  .facts dl div { padding-block: var(--space-s); border-top: 1px solid var(--border); }
  .facts dt { color: var(--gray); font-size: var(--step--1); font-weight: 700; }
  .facts dd { margin: 0.2rem 0 0; font-weight: 700; }
  .need { background: var(--surface-strong); }
  .callout { max-width: none; margin: var(--space-l) 0 0; padding-left: var(--space-m); border-left: 7px solid var(--maroon); font-weight: 700; }
  .audience-list { border-top: 1px solid var(--border); }
  .audience-list article { display: grid; grid-template-columns: 3rem minmax(8rem, 0.6fr) minmax(0, 1fr); gap: var(--space-m); padding-block: var(--space-l); border-bottom: 1px solid var(--border); }
  .audience-list article > span { color: var(--maroon); font-weight: 700; }
  .audience-list h3, .audience-list p { margin: 0; }
  .dimensions { background: var(--maroon); color: var(--white); }
  .dimensions h2 { color: var(--white); }
  .dimensions ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 var(--space-xl); }
  .dimensions li { display: grid; grid-template-columns: 3rem 1fr; gap: var(--space-s); padding-block: var(--space-m); border-top: 1px solid rgba(255,255,255,.3); }
  .dimensions li > span { color: var(--gold); font-size: var(--step-2); font-weight: 700; }
  .dimensions li p { margin: 0; }
  .dimensions li strong { display: block; color: var(--white); }
  .feature-list { border-top: 1px solid var(--border); }
  .feature-list a { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: var(--space-m); padding: var(--space-m) 0; border-bottom: 1px solid var(--border); color: var(--ink); text-decoration: none; }
  .feature-list a > span { color: var(--maroon); font-weight: 700; }
  .feature-list small { grid-column: 2; color: var(--gray); }
  .workshop-features { margin-top: calc(-1 * var(--space-s)); }
  .workshop-carousel { margin-bottom: var(--space-l); padding: var(--space-m); background: var(--surface-alt); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  @media (min-width: 64rem) {
    .zh-section-shell { display: grid; grid-template-columns: minmax(11.5rem, .38fr) minmax(0, 1.62fr); gap: clamp(2rem, 4vw, 4rem); align-items: start; }
    .zh-section-shell > .section-heading { position: sticky; top: 7rem; margin: 0; }
    .zh-section-shell > .section-heading h2 { font-size: var(--step-2); }
    .zh-section-shell > .section-heading p { font-size: var(--step-0); }
  }
  .action { margin-top: var(--space-l); }
  .projects { background: var(--dark); color: var(--white); }
  .projects h2 { color: var(--white); }
  .project-list { display: grid; gap: var(--space-s); }
  .project-list a { display: grid; gap: .2rem; padding: var(--space-m); color: var(--ink); background: var(--white); border-left: 6px solid var(--maroon); text-decoration: none; }
  .project-list span, .project-list small { color: var(--gray); }
  .contact { background: var(--surface-alt); }
  .raise-mark { min-height: 17rem; display: grid; place-items: center; background: var(--maroon); color: var(--white); border-bottom: 12px solid var(--gold); border-radius: var(--radius-l); font-size: clamp(3rem, 9vw, 6rem); font-weight: 700; letter-spacing: -.08em; }
  .raise-mark span { color: var(--gold); transform: translateY(-30%); }
  @media (max-width: 42rem) {
    .audience-list article { grid-template-columns: 3rem 1fr; }
    .audience-list article p { grid-column: 2; }
    .dimensions ol { grid-template-columns: 1fr; }
  }
</style>
