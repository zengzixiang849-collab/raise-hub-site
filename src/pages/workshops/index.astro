---
// Workshops list. Delivered and upcoming sessions are kept in separate sections.
// Intro copy: planning/homepage-about-draft.md HOME §6; empty state: content-inventory §A "Upcoming".
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkshopCard from '../../components/WorkshopCard.astro';
import AudienceFilter from '../../components/AudienceFilter.astro';
import PosterCarousel from '../../components/PosterCarousel.astro';
import { url } from '../../lib/url';

const all = (await getCollection('workshops')).sort((a, b) => a.data.order - b.data.order);
const withPoster = all.filter((w) => w.data.poster);
const delivered = all.filter((w) => w.data.status === 'delivered');
const upcoming = all.filter((w) => w.data.status === 'upcoming');

const AUDIENCE_ORDER = ['Faculty', 'Students', 'Freshmen', 'Teaching assistants'];
const audiences = AUDIENCE_ORDER.filter((a) => delivered.some((w) => w.data.audience === a));
const sessionCount = delivered.reduce((n, w) => n + (w.data.sessions?.length ?? 1), 0);
---
<BaseLayout
  title="Workshops"
  description="RAISE Hub workshops for faculty, students and teaching assistants at HAIC: observe a worked example, define a task, build something, or test and revise it."
>
  <header class="section page-hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow" aria-hidden="true">Workshops</p>
        <h1>Workshops</h1>
        <p class="lede">
          Our workshops introduce these habits and offer a route into project work and support. Depending on
          the session, participants observe a worked example, define a task, build something, or test and
          revise it.
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href="#delivered">Explore workshops →</a>
          <a class="hero-link" href={url('/about/#workshops-and-projects')}>Learn more</a>
        </div>
      </div>
      {withPoster.length > 1 && (
        <div class="hero-posters">
          <PosterCarousel workshops={withPoster} />
        </div>
      )}
    </div>
  </header>

  <section class="section" id="delivered" aria-labelledby="delivered-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="delivered-heading">Delivered</h2>
        <p class="muted">
          {sessionCount} sessions in {delivered.length} workshops, including the three-session series for
          teaching assistants.
        </p>
      </div>

      <AudienceFilter audiences={audiences} target="delivered-list" noun="workshops" />

      <ul class="card-list grid" id="delivered-list">
        {delivered.map((w) => (
          <li><WorkshopCard workshop={w} /></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--alt" id="upcoming" aria-labelledby="upcoming-heading">
    <div class="container">
      <h2 id="upcoming-heading">Upcoming</h2>
      {upcoming.length > 0 ? (
        <ul class="card-list grid">
          {upcoming.map((w) => (
            <li><WorkshopCard workshop={w} /></li>
          ))}
        </ul>
      ) : (
        <p class="empty">New sessions will be announced here.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    border-bottom: 1px solid var(--border);
    padding-block: var(--space-xl);
    background: linear-gradient(180deg, var(--surface) 0%, var(--surface-alt) 100%);
  }
  .hero-grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }
  @media (min-width: 56rem) {
    .hero-grid {
      /* text about 45 %, posters about 55 % */
      grid-template-columns: minmax(0, 9fr) minmax(0, 11fr);
    }
  }
  .hero-text .lede {
    max-width: 36rem;
  }
  .hero-text h1 {
    font-size: clamp(2.6rem, 2rem + 3.4vw, 4.25rem);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m) var(--space-l);
    margin-top: var(--space-l);
  }
  .hero-link {
    font-weight: 700;
    font-size: var(--step-1);
  }
  .hero-posters {
    width: 100%;
    max-width: 36rem;
    justify-self: center;
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-l);
    margin-bottom: var(--space-m);
  }
  .section-head h2,
  .section-head p {
    margin: 0;
  }
  .card-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .card-list > li {
    margin: 0;
    display: flex;
  }
  .card-list > li[hidden] {
    display: none;
  }
  .card-list > li > :global(*) {
    flex: 1;
  }
  .empty {
    padding: var(--space-l);
    border: 2px dashed var(--border);
    border-radius: var(--radius);
    color: var(--gray);
    background: var(--surface);
    max-width: none;
  }
</style>
