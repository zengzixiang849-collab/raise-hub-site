---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Cycle from '../components/Cycle.astro';
import FiveDimensions from '../components/FiveDimensions.astro';
import WorkshopFeatureRow from '../components/WorkshopFeatureRow.astro';
import PosterCarousel from '../components/PosterCarousel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ReviewPending from '../components/ReviewPending.astro';
import { RESOURCES } from '../lib/resources';
import { SITE } from '../lib/site';
import { url } from '../lib/url';

const workshops = (await getCollection('workshops'))
  .filter((w) => w.data.status === 'delivered')
  .sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const withPoster = workshops.filter((workshop) => workshop.data.poster);
const byId = Object.fromEntries(workshops.map((w) => [w.id, w]));
const link = (id: string, label?: string) => ({
  href: url(`/workshops/${id}/`),
  label: label ?? byId[id]?.data.title ?? id,
});
const AUDIENCES = [
  {
    name: 'Faculty',
    text: 'Build and test course assistants, and prepare clearer teaching materials with AI drafting and human checking. You keep academic judgment and every release decision.',
    links: [link('canvas-page-students-read'), link('ai-course-assistant')],
  },
  {
    name: 'Students',
    text: 'Decide which parts of an assignment you do yourself and where AI can help. Learn to check what AI gives you, and build your own learning assistant. You stay responsible for the result.',
    links: [link('pick-the-right-job-for-ai'), link('ai-learning-assistant'), link('using-ai-responsibly-freshmen')],
  },
  {
    name: 'Teaching assistants',
    text: 'Help faculty develop, test and maintain course-support tools, and hand back the evidence so faculty can decide.',
    links: [link('tsa-series', 'TSA Workshop Series (3 sessions)')],
  },
];
---
<BaseLayout>
  <Hero />

  <section class="section" id="about" aria-labelledby="about-heading">
    <div class="container brief-layout">
      <aside class="brief" aria-labelledby="brief-heading">
        <h2 id="brief-heading">RAISE in brief</h2>
        <dl>
          <div><dt>Based at</dt><dd>HNU–ASU Joint International College (HAIC)</dd></div>
          <div><dt>Works with</dt><dd>Faculty, students and teaching assistants</dd></div>
          <div><dt>Focus</dt><dd>Teaching and learning needs</dd></div>
          <div><dt>Method</dt><dd>Build, evaluate, reflect and improve</dd></div>
        </dl>
      </aside>
      <div class="brief-copy">
        <span class="section-number">01</span>
        <h2 id="about-heading">What RAISE Hub is</h2>
        <p class="lede"><strong>RAISE</strong> stands for <strong>Responsible AI Support in Education.</strong> Our tagline, <em>Responsible AI for Teaching and Learning</em>, states what we do. “Support” in the name and “teaching and learning” in the tagline both make the same point: the Hub serves faculty and students alike.</p>
        <p>The Hub helps faculty, students and teaching assistants use AI thoughtfully to address real teaching and learning needs. Its purpose is to develop both <strong>useful, reusable tools</strong> and <strong>the human judgment needed to use them responsibly</strong>.</p>
        <a class="text-link" href={url('/about/')}>About RAISE Hub</a>
      </div>
    </div>
  </section>

  <section class="section need-band" aria-labelledby="need-heading">
    <div class="container need">
      <div>
        <span class="section-number">02</span>
        <h2 id="need-heading">AI is fluent.<br />That doesn't make it right.</h2>
      </div>
      <div class="need__body">
        <p>AI tools can draft, summarize and answer questions in seconds. They can also invent a deadline, miss a key fact or agree with a wrong assumption, and sound just as confident when they do.</p>
        <p>So we start somewhere else: <strong>with a need worth addressing.</strong> We ask whether AI is appropriate for it at all, and we consider who could benefit or be affected. Because tools and needs keep changing, we check outputs and suitability again over time.</p>
      </div>
    </div>
  </section>

  <section class="section" id="approach" aria-labelledby="approach-heading">
    <div class="container section-shell">
      <div class="section-heading">
        <span class="section-number">03</span>
        <h2 id="approach-heading">Learning by doing</h2>
        <p>We learn by working on real problems:</p>
      </div>
      <div class="section-main">
        <Cycle />
        <p class="evidence-callout">A polished output or a high platform score alone is not enough evidence that a tool works well.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="audience-heading">
    <div class="container section-shell">
      <div class="section-heading">
        <span class="section-number">04</span>
        <h2 id="audience-heading">Who we work with</h2>
      </div>
      <ol class="audiences section-main">
        {AUDIENCES.map((audience) => (
          <li>
            <h3>{audience.name}</h3>
            <p>{audience.text}</p>
            <ul aria-label={`Workshops for ${audience.name.toLowerCase()}`}>
              {audience.links.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section dimensions-band" aria-labelledby="dimensions-heading">
    <div class="container section-shell">
      <div class="section-heading section-heading--light">
        <span class="section-number">05</span>
        <h2 id="dimensions-heading">Five questions we ask of every tool</h2>
      </div>
      <div class="section-main">
        <FiveDimensions variant="dark" />
        <p class="dimensions-band__more"><a href={url('/about/#responsible')}>Read more about how we evaluate</a></p>
      </div>
    </div>
  </section>

  <section class="section" id="workshops" aria-labelledby="workshops-heading">
    <div class="container section-shell">
      <div class="section-heading">
        <span class="section-number">06</span>
        <h2 id="workshops-heading">Featured workshops</h2>
        <p>Our workshops introduce these habits and offer a route into project work and support. Depending on the session, participants observe a worked example, define a task, build something, or test and revise it.</p>
      </div>
      <div class="section-main">
        {withPoster.length > 1 && (
          <div class="workshop-carousel">
            <PosterCarousel workshops={withPoster} />
          </div>
        )}
        <div class="workshop-features">
          {workshops.map((workshop) => <WorkshopFeatureRow workshop={workshop} />)}
        </div>
        <p class="section-action"><a class="button button--secondary" href={url('/workshops/')}>See all workshops</a></p>
      </div>
    </div>
  </section>

  <section class="section projects-band" id="projects" aria-labelledby="projects-heading">
    <div class="container projects-layout">
      <div class="projects-intro">
        <span class="section-number">07</span>
        <h2 id="projects-heading">Demonstration projects</h2>
        <p class="lede">Every project follows build → evaluate → improve. A project is complete only together with its reviewed evaluation.</p>
        <a class="button button--secondary" href={url('/projects/')}>See all projects</a>
      </div>
      <div class="project-list">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section" id="resources" aria-labelledby="resources-heading">
    <div class="container section-shell resources-layout">
      <div class="section-heading">
        <span class="section-number">08</span>
        <h2 id="resources-heading">Practical resources</h2>
        <p>Practical guides from RAISE Hub workshops on using and checking AI responsibly.</p>
      </div>
      <div class="section-main">
        <ol class="resource-list">
          {RESOURCES.slice(0, 6).map((resource, index) => (
            <li>
              <a href={url(`/resources/#${resource.id}`)}>
                <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <strong>{resource.title}</strong>
              </a>
            </li>
          ))}
        </ol>
        <p class="section-action"><a class="button button--secondary" href={url('/resources/')}>Browse all resources</a></p>
      </div>
    </div>
  </section>

  <section class="section lead-band" id="contact" aria-labelledby="contact-heading">
    <div class="container lead-layout">
      <div class="lead-profile" aria-hidden="true">
        <span class="lead-profile__mark">R<span>AI</span>SE</span>
      </div>
      <div>
        <span class="section-number">09</span>
        <h2 id="contact-heading">Led by Annus Azhar, Ph.D.</h2>
        <p>RAISE Hub is based at the <strong>HNU–ASU Joint International College (HAIC)</strong>. It was founded by <strong>Annus Azhar, Ph.D.</strong>, Assistant Teaching Professor in the School of Public Affairs, Arizona State University.</p>
        <p class="lede">Interested in a workshop, a project idea or support for your course? Contact Annus Azhar, Ph.D., at <a href={`mailto:${SITE.contactEmail}`}><strong>{SITE.contactEmail}</strong></a>.</p>
        <ReviewPending item="A5" note="Confirm the founder line and title wording, public email, and whether to add office hours or a location." />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-main { min-width: 0; }
  @media (min-width: 64rem) {
    .section-shell {
      display: grid;
      grid-template-columns: minmax(11.5rem, 0.38fr) minmax(0, 1.62fr);
      gap: clamp(2rem, 4vw, 4rem);
      align-items: start;
    }
    .section-shell > .section-heading {
      position: sticky;
      top: 7rem;
      margin: 0;
      max-width: none;
    }
    .section-shell > .section-heading h2 {
      font-size: var(--step-2);
    }
    .section-shell > .section-heading p {
      font-size: var(--step-0);
    }
  }

  .brief-layout {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }
  @media (min-width: 58rem) {
    .brief-layout { grid-template-columns: minmax(14rem, 0.68fr) minmax(0, 1.8fr); }
    .brief { position: sticky; top: 7rem; }
  }
  .brief {
    background: var(--surface-alt);
    border-top: 8px solid var(--maroon);
    padding: var(--space-l);
  }
  .brief h2 { font-size: var(--step-1); color: var(--ink); }
  .brief dl { margin: var(--space-l) 0 0; }
  .brief dl div { padding-block: var(--space-s); border-top: 1px solid var(--border); }
  .brief dt { font-size: var(--step--1); color: var(--gray); font-weight: 700; }
  .brief dd { margin: 0.15rem 0 0; font-weight: 700; }
  .brief-copy h2 { margin-top: var(--space-xs); }
  .brief-copy p { font-size: var(--step-1); }
  .text-link { display: inline-block; margin-top: var(--space-s); font-weight: 700; }

  .need-band { background: var(--surface-strong); }
  .need { display: grid; gap: var(--space-l) var(--space-xl); }
  .need h2 { margin-top: var(--space-xs); }
  .need__body p { font-size: var(--step-1); }
  @media (min-width: 58rem) {
    .need { grid-template-columns: 0.95fr 1.25fr; }
  }

  .evidence-callout {
    max-width: none;
    margin: var(--space-l) 0 0;
    padding-left: var(--space-m);
    border-left: 7px solid var(--maroon);
    font-weight: 700;
  }

  .audiences { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .audiences > li {
    margin: 0;
    padding-block: var(--space-m);
    display: grid;
    gap: var(--space-s);
    border-bottom: 1px solid var(--border);
  }
  .audiences h3,
  .audiences p,
  .audiences ul { margin: 0; }
  .audiences h3 {
    color: var(--maroon);
    font-size: var(--step-1);
  }
  .audiences p { max-width: 62ch; }
  .audiences ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem var(--space-m);
    font-size: var(--step--1);
    line-height: 1.4;
  }
  .audiences a { font-weight: 700; text-underline-offset: 0.2em; }
  @media (min-width: 40rem) {
    .audiences > li {
      grid-template-columns: minmax(9.5rem, 0.45fr) minmax(0, 1.55fr);
      gap: var(--space-xs) var(--space-l);
    }
    .audiences h3 { grid-row: 1 / span 2; }
    .audiences p,
    .audiences ul { grid-column: 2; }
  }
  @media (min-width: 72rem) {
    .audiences > li {
      grid-template-columns: minmax(9.5rem, 0.45fr) minmax(18rem, 1.35fr) minmax(13rem, 0.8fr);
      gap: var(--space-l);
      align-items: start;
    }
    .audiences h3,
    .audiences p,
    .audiences ul { grid-column: auto; grid-row: auto; }
    .audiences ul { display: grid; gap: 0.35rem; }
  }

  .dimensions-band { background: var(--maroon); color: var(--white); }
  .section-heading--light h2 { color: var(--white); }
  .section-heading--light .section-number { color: var(--light-gray); }
  .dimensions-band__more { margin: var(--space-l) 0 0; }
  .dimensions-band a { color: var(--white); font-weight: 700; }
  .dimensions-band :focus-visible { outline-color: var(--gold); }

  .workshop-carousel {
    margin-bottom: var(--space-l);
    padding: var(--space-m);
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .workshop-features { margin-top: 0; }
  .section-action { margin: var(--space-l) 0 0; }

  .projects-band { background: var(--dark); color: var(--white); }
  .projects-layout { display: grid; gap: var(--space-xl); align-items: start; }
  .projects-intro h2 { color: var(--white); }
  .projects-intro .lede { color: var(--light-gray); }
  .projects-intro .button { border-color: var(--white); color: var(--white); }
  .projects-intro .button:hover { background: var(--white); color: var(--dark); }
  .project-list { display: grid; gap: var(--space-m); }
  @media (min-width: 62rem) {
    .projects-layout { grid-template-columns: minmax(16rem, 0.72fr) minmax(0, 1.55fr); }
    .projects-intro { position: sticky; top: 7rem; }
  }

  .resources-layout { max-width: var(--content-max); }
  .resource-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .resource-list li { margin: 0; border-bottom: 1px solid var(--border); }
  .resource-list a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-m);
    padding-block: var(--space-m);
    color: var(--ink);
    text-decoration: none;
  }
  .resource-list a span { color: var(--maroon); font-weight: 700; }
  .resource-list a:hover strong { color: var(--maroon); text-decoration: underline; }

  .lead-band { background: var(--surface-alt); }
  .lead-layout { display: grid; gap: var(--space-xl); align-items: center; }
  .lead-profile {
    min-height: 18rem;
    display: grid;
    place-items: center;
    background: var(--maroon);
    border-bottom: 12px solid var(--gold);
    border-radius: var(--radius-l);
    overflow: hidden;
  }
  .lead-profile__mark { color: var(--white); font-size: clamp(3rem, 9vw, 6.5rem); font-weight: 700; letter-spacing: -0.08em; }
  .lead-profile__mark span { display: inline-block; color: var(--gold); transform: translateY(-30%); }
  @media (min-width: 58rem) {
    .lead-layout { grid-template-columns: minmax(18rem, 0.75fr) minmax(0, 1.25fr); }
  }
</style>
